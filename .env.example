# Copie para .env (nunca envie o .env para o Git ou para o navegador).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
# Endereço público do site, sem barra no final. Obrigatório em produção.
SITE_URL=https://meuteto.com.br
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
FORM_SECRET=
# Opcional: Google Analytics 4 (ID de métricas, formato G-XXXXXXXXXX). Só carrega depois que o visitante aceita as estatísticas.
GA_MEASUREMENT_ID=
# Opcional: Cloudflare Turnstile (anti-robô). A chave do site é pública; a chave secreta fica só aqui.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Onde os contatos do formulário são gravados (fora da pasta pública).
LEADS_FILE=./data/leads.jsonl
